# Runtime
PORT=8000

# Postgres (Supabase, Neon, RDS, etc.)
# Use the pooled connection in DATABASE_URL and the direct connection in DIRECT_URL.
DIRECT_URL="postgresql://user:password@direct-host:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://user:password@pooler-host:5432/postgres?sslmode=require&pgbouncer=true"

# JWT
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI provider
# Gemini is the active implementation; GOOGLE_API_KEY remains accepted as a compatibility alias.
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# CORS / frontend origin for the deployed app
# Use the deployed origin(s), comma-separated if more than one.
FRONTEND_URL=http://localhost:8080
