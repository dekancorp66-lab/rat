# Point at the FastAPI backend (local or deployed) — server-side (ai.ts).
BACKEND_URL=http://127.0.0.1:8000

# Same backend, but exposed to the browser (Vite only exposes VITE_-prefixed
# vars to client code). Used by src/lib/simple-auth and the chat thread.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Design feature (Wadi) — replaces the old static /design bundle. Points at
# the design-studio service; update to its deployed URL in production.
VITE_DESIGN_STUDIO_URL=http://localhost:8082
